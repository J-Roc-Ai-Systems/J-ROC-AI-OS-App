# Copy to .env on the backend host. Never commit the real .env file.
# OpenAI provider key: set this only in the backend secret manager/environment.
OPENAI_API_KEY=replace-with-your-own-provider-key

# Long random token required by the Android app to access this private gateway.
# Generate a unique value; do not reuse your OpenAI API key.
JROCAI_GATEWAY_TOKEN=replace-with-a-long-random-gateway-token

# Strict zero-dollar policy: paid cloud model calls remain blocked unless explicitly authorized.
JROCAI_ALLOW_PAID_CLOUD=false
JROCAI_MONTHLY_SPENDING_LIMIT_USD=0

# Optional local model runtime. Must remain on loopback; no cloud fallback.
JROCAI_LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434

# Required only when encrypted user file storage is enabled.
# Generate 32 random bytes and Base64URL-encode them in the secret manager.
# Never use this placeholder as a real key or commit a real key.
JROCAI_FILE_ENCRYPTION_KEY=SET_IN_ENVIRONMENT_AGENT_SECRET_STORE
JROCAI_ENCRYPTED_FILE_ROOT=data/encrypted-files

# Chairman role provisioning is disabled by default.
JROCAI_ALLOW_CHAIRMAN_ROLE_ASSIGNMENT=false
