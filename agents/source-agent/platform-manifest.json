{
  "manifestVersion": "1.0.0",
  "agentId": "jrocai.source",
  "displayName": "J-ROC AI Source Agent",
  "version": "1.0.0",
  "description": "Platform-wide source discovery, metadata capture, provenance validation, license review, and deduplication.",
  "scope": "platform-wide",
  "owner": "J-ROC AI Platform",
  "lifecycleState": "registered",
  "domains": ["engineering", "research", "knowledge"],
  "capabilities": [
    { "id": "source.discover", "description": "Discover authorized source candidates.", "risk": "low" }
  ],
  "supportedHosts": ["android", "windows", "linux", "web", "cloud"],
  "permissions": {
    "capabilities": ["source.discover"],
    "filesystem": [],
    "network": [],
    "repositories": [],
    "dataScopes": ["tenant"]
  },
  "dependencies": { "agents": [], "services": ["source-catalog", "source-inspector", "audit-store"] },
  "secrets": {
    "environmentAgentManaged": true,
    "secretReferences": []
  },
  "approvalGates": {
    "humanApprovalRequiredFor": ["private-repository-access", "dependency-import", "production-source-replacement"],
    "standingAuthorizationAllowed": false
  },
  "audit": { "required": true, "redactSecrets": true },
  "execution": { "mayExecuteUntrustedCode": false, "timeoutSeconds": 60, "retryLimit": 1 },
  "health": { "readinessCheck": "required-before-available", "lastVerifiedAt": null },
  "tests": {
    "requiredBeforeAvailable": true,
    "testPaths": ["platform/agents/runtime/test/source-agent.test.mjs"]
  },
  "notes": "Registered as a platform identity; not available for dispatch until adapters, persistent stores, runtime registration, and tests are connected and verified."
}
