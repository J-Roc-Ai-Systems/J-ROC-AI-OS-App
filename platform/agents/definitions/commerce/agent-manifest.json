{
  "manifestVersion": "1.0.0",
  "agentId": "jrocai.commerce",
  "displayName": "Commerce Agent",
  "version": "1.0.0",
  "description": "catalog, storefront, orders, subscriptions and customer workflows",
  "scope": "platform-wide",
  "owner": "J-ROC AI Platform",
  "lifecycleState": "specified",
  "domains": [
    "business"
  ],
  "capabilities": [
    {
      "id": "commerce.prepare",
      "description": "Prepare recommendations and plans for: catalog, storefront, orders, subscriptions and customer workflows",
      "risk": "low",
      "requiresApproval": false
    },
    {
      "id": "commerce.execute",
      "description": "Execute the approved operation for: catalog, storefront, orders, subscriptions and customer workflows",
      "risk": "high",
      "requiresApproval": true
    }
  ],
  "supportedHosts": [
    "android",
    "windows",
    "linux",
    "web",
    "cloud"
  ],
  "permissions": {
    "capabilities": [
      "commerce.prepare",
      "commerce.execute"
    ],
    "filesystem": [],
    "network": [],
    "repositories": [],
    "dataScopes": [
      "tenant"
    ]
  },
  "dependencies": {
    "agents": [],
    "services": []
  },
  "secrets": {
    "environmentAgentManaged": true,
    "secretReferences": []
  },
  "approvalGates": {
    "humanApprovalRequiredFor": [
      "external-write",
      "production-change",
      "financial-action",
      "destructive-action",
      "permission-change",
      "private-repository-access"
    ],
    "standingAuthorizationAllowed": false
  },
  "audit": {
    "required": true,
    "redactSecrets": true
  },
  "execution": {
    "mayExecuteUntrustedCode": false,
    "timeoutSeconds": 60,
    "retryLimit": 1
  },
  "health": {
    "status": "pending",
    "readinessCheck": "not-implemented",
    "lastVerifiedAt": null
  },
  "tests": {
    "status": "pending",
    "requiredBeforeAvailable": true,
    "testPaths": []
  }
}
