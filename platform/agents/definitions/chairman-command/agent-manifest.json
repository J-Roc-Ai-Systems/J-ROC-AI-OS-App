{
  "manifestVersion": "1.0.0",
  "agentId": "jrocai.chairman-command",
  "displayName": "Chairman Command Agent",
  "version": "1.0.0",
  "description": "executive command intake, priorities, approvals and cross-product task routing",
  "scope": "platform-wide",
  "owner": "J-ROC AI Platform",
  "lifecycleState": "specified",
  "domains": [
    "coordination"
  ],
  "capabilities": [
    {
      "id": "command.coordinate",
      "description": "Coordinate approved work and request decisions",
      "risk": "low",
      "requiresApproval": false
    }
  ],
  "supportedHosts": [
    "android",
    "windows",
    "linux",
    "web",
    "cloud"
  ],
  "permissions": {
    "capabilities": [
      "command.coordinate"
    ],
    "filesystem": [],
    "network": [],
    "repositories": [],
    "dataScopes": [
      "tenant"
    ]
  },
  "dependencies": {
    "agents": [],
    "services": []
  },
  "secrets": {
    "environmentAgentManaged": true,
    "secretReferences": []
  },
  "approvalGates": {
    "humanApprovalRequiredFor": [
      "external-write",
      "production-change",
      "financial-action",
      "destructive-action",
      "permission-change",
      "private-repository-access"
    ],
    "standingAuthorizationAllowed": false
  },
  "audit": {
    "required": true,
    "redactSecrets": true
  },
  "execution": {
    "mayExecuteUntrustedCode": false,
    "timeoutSeconds": 60,
    "retryLimit": 1
  },
  "health": {
    "status": "pending",
    "readinessCheck": "not-implemented",
    "lastVerifiedAt": null
  },
  "tests": {
    "status": "pending",
    "requiredBeforeAvailable": true,
    "testPaths": []
  }
}
