  "service_name": "J-ROC AI Platform Agent Service",
  "version": "1.0.0",
  "status": "architecture_and_registry",
  "scope": "Platform-wide; independent of Android, web, desktop, and backend clients.",
  "governance": {
    "owner": "Chairman",
    "secret_authority": "jrocai.environment",
    "default_access": "least_privilege",
    "require_audit": true,
    "require_human_approval_for": [
      "production_deployments",
      "repository_merge",
      "dependency_import",
      "data_deletion",
      "permission_changes",
      "external_publication",
      "financial_actions",
      "device_firmware_changes",
      "security_policy_changes"
    ],
    "deny_by_default": true,
    "untrusted_code_execution": false,
    "agent_to_agent_calls": "capability_checked_and_audited"
  },
  "shared_services": [
    "agent_registry",
    "agent_dispatcher",
    "policy_engine",
    "identity_and_access_control",
    "environment_and_secret_broker",
    "audit_event_store",
